---
permalink: /_bulletin/flat.html
eleventyExcludeFromCollections: true
---
{% from "macros.njk" import programBlock %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ site.title }} Bulletin (flat)</title>
<style>
  @page { size: Letter; margin: 0.5in; }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body { font-family: "Source Serif 4", Georgia, "Times New Roman", serif; color: #000; font-size: 11pt; line-height: 1.35; }
  a { color: #000; text-decoration: none; word-break: break-word; }

  .sheet { page-break-after: always; }
  .sheet:last-child { page-break-after: auto; }

  h1 { font-size: 20pt; margin: 0; text-align: center; }
  .subtitle { text-align: center; font-style: italic; margin: 2pt 0 0; }
  .meta { text-align: center; margin: 4pt 0 14pt; font-size: 10pt; }
  .section-title { font-size: 15pt; text-align: center; border-bottom: 1.5pt solid #000; padding-bottom: 4pt; margin: 0 0 10pt; }

  .pg-date { font-weight: 700; text-align: center; margin-bottom: 10pt; }
  .pg-group { margin-bottom: 9pt; }
  .pg-row { display: grid; grid-template-columns: 1.7in 1fr; gap: 1pt 8pt; padding: 1pt 0; }
  .pg-label { font-weight: 700; }
  .pg-note { margin: 4pt 0 0; font-style: italic; font-size: 10pt; }
  .pg-note--center { text-align: center; font-style: normal; font-weight: 700; }

  .announce { columns: 2; column-gap: 0.4in; font-size: 9.5pt; line-height: 1.3; }
  .announce p { margin: 0 0 6pt; break-inside: avoid; }
  .announce ul { margin: 0 0 6pt; padding-left: 1.1em; break-inside: avoid; }
  .footer-note { text-align: center; font-size: 8.5pt; font-style: italic; margin-top: 12pt; }
</style>
</head>
<body>
  <div class="sheet">
    <h1>{{ site.title }}</h1>
    <p class="subtitle">of {{ site.church }}</p>
    <p class="meta">{{ site.address }} &nbsp;&middot;&nbsp; Sacrament Meeting begins at {{ site.sacramentTime }}</p>
    <h2 class="section-title">Sacrament Meeting Program</h2>
    {{ programBlock(program) }}
  </div>
  <div class="sheet">
    <h2 class="section-title">Announcements</h2>
    <div class="announce">{{ copy.announcements | safe }}</div>
    <p class="footer-note">Submit an announcement: {{ site.submissionFormUrl }}</p>
  </div>
</body>
</html>
